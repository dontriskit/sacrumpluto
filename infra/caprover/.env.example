# Copy to .env and fill in. The .env file is gitignored.

# ─── CapRover server ─────────────────────────────────────────────────────────
CAPROVER_URL=https://captain.your-box.example.com
CAPROVER_PASSWORD=your-captain-password

# ─── App name on CapRover ────────────────────────────────────────────────────
WEB_APP=sacrumpluto

# ─── Public URL the site serves from ────────────────────────────────────────
# For first boot, use the CapRover-assigned subdomain, e.g.:
#   https://sacrumpluto.captain.your-box.example.com
# Switch to your custom domain after attaching it (see web-up.sh footer).
NEXT_PUBLIC_SITE_URL=https://sacrumpluto.captain.your-box.example.com
